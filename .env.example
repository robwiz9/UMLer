# Public GitHub OAuth App client id. Enable "Device flow" on the OAuth App.
# Local development: copy this file to `.env.local` and fill the value.
# Vercel: add GITHUB_OAUTH_CLIENT_ID in Project Settings → Environment
# Variables (Production and Preview), then redeploy. `.env.local` is not
# uploaded by Vercel. No client secret is used.
GITHUB_OAUTH_CLIENT_ID=

# Optional alias accepted by the Vercel functions for existing deployments.
# VITE_GITHUB_CLIENT_ID=

# Live collaboration room server (temporary cache; GitHub remains durable).
# In local development, `npm run collab:server` listens on 1234.
VITE_COLLAB_URL=ws://127.0.0.1:1234
# Shared development token; must match the server's COLLAB_ACCESS_TOKEN.
# Do not use a shared token in production; use the GitHub permission/JWT flow.
VITE_COLLAB_TOKEN=
COLLAB_ACCESS_TOKEN=
# HMAC secret shared by the Vercel token function and the collaboration server.
# When set, the browser gets a short-lived GitHub-permission-scoped room JWT.
COLLAB_SECRET=
# Administrator code that enables a GitHub-backed room. The browser derives a
# per-project key with HMAC-SHA256; the raw code is never sent to the server.
# Use a long random value. Leave empty for local development rooms only.
COLLAB_ADMIN_CODE=
# Optional Upstash Redis REST credentials. Room snapshots are written every few
# seconds while dirty, never per action or per cursor movement.
UMLER_STORAGE_KV_REST_API_URL=
UMLER_STORAGE_KV_REST_API_TOKEN=
# Optional Vercel Blob read/write token. Large image bytes are stripped from
# room snapshots and hydrated back when a room is restored.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
# Blob access mode: auto, public, or private. Auto retries the other mode once.
BLOB_ACCESS=auto
# Snapshot policy: Redis interval and the minimum image size moved to Blob.
COLLAB_REDIS_SNAPSHOT_MS=5000
COLLAB_BLOB_MIN_BYTES=4096
COLLAB_PORT=1234
COLLAB_TTL_HOURS=4
